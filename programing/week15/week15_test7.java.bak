import java.io.FileWriter;
import java.io.File;
import java.io.IOException;
import java.util.Scanner;
class week15_test7 
{
	public static void main(String[] args) 
	{
		String fileName="pop.xls";
		String score;
		
			
		try
		{
			Scanner sc=new Scanner(System.in);
			FileWriter fi=new FileWriter(new File(fileName));
			String x="CODE\tNAME\tMIDTERM\tFINAL\tSUM\n";
			System.out.println("input(,) MIDTERM|FINAL:");
				score=sc.next();
			String[] parts = score.split(",");
				int mid=Integer.parseInt(parts[0]);
				int fin=Integer.parseInt(parts[1]);
				fi.write(mid+"\t");
				fi.write(fin+"\t");
				System.out.println("x = " + mid);
				System.out.println("y = " + fin);
			fi.close();
		}
		catch (IOException cxxx)
		{
		}
		
		
	}
}
